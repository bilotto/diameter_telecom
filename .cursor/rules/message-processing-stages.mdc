# Message Processing Stages

## Current Architecture (Post-Refactoring)

### SessionManager Entry Point
```python
# SessionManager delegates to MessageProcessingPipeline
def process_diameter_message(self, dm: DiameterMessage):
    """Main entry point - orchestrates processing via pipeline"""
    # Setup processing context
    gv_stages = dict()
    if not dm.timestamp:
        dm.timestamp = time.time()
    gv_stages['dm'] = dm
    gv_stages['session_id'] = dm.session_id
    gv_stages['app_id'] = dm.app_id
    
    # Delegate to pipeline for processing
    if dm.is_request:
        self.pipeline.stage_parse_request(gv_stages)
    else:
        self.pipeline.stage_parse_response(gv_stages)
    
    # Process application-specific business logic
    self.pipeline.process_app_specific_logic(gv_stages)
    
    # Handle final message storage and association
    session = gv_stages.get('session')
    if session:
        session.messages.append(dm)  # Direct append to messages list
        subscriber = gv_stages.get('subscriber')
        if subscriber:
            subscriber.add_message(dm)
            dm.subscriber = subscriber
    
    self.messages.append(dm)  # Final storage in SessionManager
```

## MessageProcessingPipeline Stages

All pipeline stages use `gv_stages: Dict` context pattern:

### Stage 1: Get Existing Session
```python
def stage_get_session(self, gv_stages: Dict):
    """Retrieve existing session from storage"""
    app_id = gv_stages['app_id']
    session_id = gv_stages['session_id'] 
    session = self.sessions.get_session_by_id(app_id, session_id)
    if session:
        gv_stages['session'] = session  # Store in context
```

### Stage 2: Create New Session
```python
def stage_create_session(self, gv_stages: Dict):
    """Create a new session for the message"""
    dm: DiameterMessage = gv_stages['dm']
    app_id = dm.app_id
    session_id = dm.session_id
    subscriber = gv_stages.get('subscriber')

    # Extract session attributes from message
    framed_ip_address = getattr(dm.message, 'framed_ip_address', None)
    framed_ipv6_prefix = getattr(dm.message, 'framed_ipv6_prefix', None)
    called_station_id = getattr(dm.message, 'called_station_id', None)
    sgsn_mcc_mnc = getattr(dm.message, 'sgsn_mcc_mnc', None)
    
    # Create appropriate session type
    if app_id == APP_3GPP_GX:
        session = GxSession(session_id=session_id, framed_ip_address=framed_ip_address, 
                          framed_ipv6_prefix=framed_ipv6_prefix, called_station_id=called_station_id, 
                          sgsn_mcc_mnc=sgsn_mcc_mnc, subscriber=subscriber)
    elif app_id == APP_3GPP_RX:
        session = RxSession(session_id=session_id, subscriber=subscriber)
    elif app_id == APP_3GPP_SY:
        session = SySession(session_id=session_id, subscriber=subscriber)
    else:
        raise ValueError(f"Unknown app_id: {app_id}")

    gv_stages['session'] = session  # Store in context

    # Update subscriber's session_ids tracking
    if subscriber:
        subscriber.session_ids[app_id] = session_id
        
    # Perform application-specific binding
    if app_id == APP_3GPP_RX:
        self.stage_bind_rx_to_gx(gv_stages)
    elif app_id == APP_3GPP_SY:
        self.stage_bind_sy_to_gx(gv_stages)
    
    self.sessions.add_session(app_id, session)
```

### Stage 3: Get/Identify Subscriber
```python
def stage_get_subscriber(self, gv_stages: Dict):
    """Get subscriber from existing session if available"""
    if gv_stages.get('session') and gv_stages['session'].subscriber:
        subscriber = gv_stages['session'].subscriber
        gv_stages['subscriber'] = subscriber

def stage_identify_subscriber(self, gv_stages: Dict):
    """Identify subscriber from message content"""
    dm = gv_stages['dm']
    if hasattr(dm.message, 'subscription_id') and dm.message.subscription_id:
        msisdn, imsi, sip_uri, nai, private_id = parse_subscription_id(dm.message.subscription_id)
        subscriber = self.subscribers.get_subscriber_by_msisdn(msisdn) or self.subscribers.get_subscriber_by_imsi(imsi)
        if not subscriber:
            subscriber = Subscriber(msisdn=msisdn, imsi=imsi, sip_uri=sip_uri, nai=nai, private_id=private_id)
            self.subscribers.add_subscriber(subscriber)
        gv_stages['subscriber'] = subscriber
```

### Stage 4: Parse Request/Response
```python
def stage_parse_request(self, gv_stages: Dict):
    """Process request message through the pipeline stages"""
    dm = gv_stages['dm']
    self.stage_get_session(gv_stages)
    self.stage_get_subscriber(gv_stages)
    
    if not gv_stages.get('subscriber'):
        self.stage_identify_subscriber(gv_stages)
    
    if not gv_stages.get('session') and dm.name in CREATE_SESSION_MESSAGES:
        self.stage_create_session(gv_stages)

def stage_parse_response(self, gv_stages: Dict):
    """Process response message through the pipeline stages"""
    self.stage_get_session(gv_stages)
    self.stage_get_subscriber(gv_stages)
```

## Session Binding (New Optimized Pattern)

### Sy-to-Gx Binding
```python
def stage_bind_sy_to_gx(self, gv_stages: Dict):
    """Bind SySession to existing active GxSession using subscriber.session_ids"""
    sy_session = gv_stages['session']
    subscriber = gv_stages.get('subscriber')
    
    # Direct lookup using subscriber.session_ids for performance
    gx_session_id = subscriber.session_ids.get(APP_3GPP_GX)
    if gx_session_id:
        gx_session = self.sessions.get_session_by_id(APP_3GPP_GX, gx_session_id)
        if gx_session:
            sy_session.gx_session_id = gx_session.session_id
```

